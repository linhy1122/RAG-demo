# Milvus + MinIO Docker Compose 环境变量配置
# 修改此文件后需重新执行 docker compose up -d 生效

# ============ MinIO 凭证 ============
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============ MinIO 桶名 ============
MINIO_BUCKET_NAME=milvus-bucket

# ============ Docker 数据卷根目录 ============
# 留空则使用当前目录下的 volumes/ 子目录
# 如需指定绝对路径，例如：DOCKER_VOLUME_DIRECTORY=/data/milvus
DOCKER_VOLUME_DIRECTORY=.
